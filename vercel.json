{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{backend/**,tools/**,.venv/**,data/**,spaces/**}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/login",
      "destination": "/frontend/login.html"
    },
    {
      "source": "/signup",
      "destination": "/frontend/signup.html"
    },
    {
      "source": "/summarize",
      "destination": "/api/summarize"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/sample",
      "destination": "/api/sample"
    },
    {
      "source": "/auth/signup",
      "destination": "/api/auth_signup"
    },
    {
      "source": "/auth/login",
      "destination": "/api/auth_login"
    },
    {
      "source": "/auth/logout",
      "destination": "/api/auth_logout"
    },
    {
      "source": "/auth/me",
      "destination": "/api/auth_me"
    }
  ]
}
