{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/summarize.py": {
      "maxDuration": 60
    },
    "api/health.py": {
      "maxDuration": 60
    },
    "api/sample.py": {
      "maxDuration": 60
    },
    "api/auth_signup.py": {
      "maxDuration": 60
    },
    "api/auth_login.py": {
      "maxDuration": 60
    },
    "api/auth_logout.py": {
      "maxDuration": 60
    },
    "api/auth_me.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/login",
      "destination": "/frontend/login.html"
    },
    {
      "source": "/signup",
      "destination": "/frontend/signup.html"
    },
    {
      "source": "/summarize",
      "destination": "/api/summarize"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/sample",
      "destination": "/api/sample"
    },
    {
      "source": "/auth/signup",
      "destination": "/api/auth_signup"
    },
    {
      "source": "/auth/login",
      "destination": "/api/auth_login"
    },
    {
      "source": "/auth/logout",
      "destination": "/api/auth_logout"
    },
    {
      "source": "/auth/me",
      "destination": "/api/auth_me"
    }
  ]
}
